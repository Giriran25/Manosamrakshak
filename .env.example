# ===========================================================================
# ManoSamRakshak - configuration
#
# The prototype runs with NONE of this set. Chat and voice are real without
# any credential; SMS and telephony become live when a provider is configured
# below, and the UI says which state each channel is in.
#
# Copy to .env and fill in only what you want to turn on.
# ===========================================================================


# ---------------------------------------------------------------------------
# PUBLIC - compiled into the browser bundle. Treat everything here as public.
# ---------------------------------------------------------------------------

# Where the API server is. Leave blank when the browser and the API share an
# origin, or when running with no server at all.
VITE_API_URL=http://localhost:8787

# Supabase project, read through the anon key with row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# SERVER ONLY - never give any of these a VITE_ prefix. They are read by the
# API server process and are never sent to the browser: the client learns only
# WHETHER a capability is configured, never what it is configured with.
#
# npm run verify fails the build if any of these names appears under src/.
# ---------------------------------------------------------------------------

# The API server itself.
PORT=8787
# The externally reachable base URL. Provider webhooks are signed against the
# full URL, so this must match exactly what the provider calls - use the
# public tunnel URL when testing SMS or telephony locally.
PUBLIC_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database -------------------------------------------------------------
# Service-role key. Server side only, always.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- SMS ------------------------------------------------------------------
# Any Twilio-compatible provider. All four are required before SMS goes live.
SMS_PROVIDER=
SMS_ACCOUNT_ID=
SMS_AUTH_SECRET=
SMS_FROM_NUMBER=
# Local testing only: skips inbound signature verification. Never set this in
# a deployment - it is the only thing stopping a forged check-in.
SMS_SKIP_VERIFICATION=false

# ---- Telephony / IVRS -----------------------------------------------------
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_SECRET=
TELEPHONY_FROM_NUMBER=
TELEPHONY_SKIP_VERIFICATION=false
# Only set true if the provider account is actually configured for speech
# input. The product does not offer speech unless this is on.
TELEPHONY_SPEECH_ENABLED=false

# ---- Speech to text (optional) --------------------------------------------
# The primary transcription path is the browser's own recognition, which needs
# nothing here. This is for deployments with an on-premise or provider ASR
# service. Audio is forwarded once and never written to disk or the database.
ASR_PROVIDER=
ASR_ENDPOINT=
ASR_API_KEY=

# ---- Demo routing ---------------------------------------------------------
# The handset registered for the demo. An inbound SMS or call from this number
# is routed to DEMO_CASE_ID; any other number is refused and never routed.
# Use a test number you control. Never a real person's.
DEMO_PHONE_NUMBER=
DEMO_CASE_ID=VC-3007
